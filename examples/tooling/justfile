import "../../just/checks.just"
# Article workflows. Just owns commands; imported Python modules are libraries.
set positional-arguments
export PYTHONPATH := justfile_directory() / ".." / ".."
python := env("LOONG_PYTHON", "python3")
import '../../just/evaluation.just'
import '../../just/inspection.just'
import '../../just/match.just'

default:
    @just --list

article-bots:
    unswbc maps
    unswbc init c starter-c
    unswbc init python starter-py
    cp -r ../the-choice/c room-c
    cp -r ../the-choice/python room-py
    cp starter-c/helper.c starter-c/helper.h room-c/
    cp starter-c/helper.c starter-c/helper.h room-pearls/
    cp "$(nim dump 2>&1 | grep -m1 '/lib$')/nimbase.h" room-pearls/
    nim c room-pearls/strategy.nim
    cp starter-py/helper.py room-py/

first-bot:
    rm -rf first-bot && cp -r ../first-bot first-bot
    rm -rf repertoire && cp -r ../repertoire repertoire
    cp starter-c/helper.c starter-c/helper.h first-bot/
    cp "$(nim dump 2>&1 | grep -m1 '/lib$')/nimbase.h" first-bot/
    nim c first-bot/strategy.nim
    just verdict --candidate first-bot --baseline room-c \
        --maps maps/*.map maps-generated/*.map --seeds 4

roles:
    rm -rf roles-bot && cp -r ../roles-bot roles-bot
    rm -rf repertoire && cp -r ../repertoire repertoire
    cp starter-c/helper.c starter-c/helper.h roles-bot/
    cp "$(nim dump 2>&1 | grep -m1 '/lib$')/nimbase.h" roles-bot/
    nim c roles-bot/strategy.nim
    just verdict --candidate roles-bot --baseline first-bot \
        --maps maps/*.map maps-generated/*.map --seeds 2

tactics:
    rm -rf tactics-bot && cp -r ../tactics-bot tactics-bot
    rm -rf repertoire && cp -r ../repertoire repertoire
    cp starter-c/helper.c starter-c/helper.h tactics-bot/
    cp "$(nim dump 2>&1 | grep -m1 '/lib$')/nimbase.h" tactics-bot/
    nim c tactics-bot/strategy.nim
    just verdict --candidate tactics-bot --baseline roles-bot --behaviour Coil Forage \
        --maps maps/*.map maps-generated/*.map --seeds 4

nim-bot name:
    rm -rf {{name}} && cp -r ../{{name}} {{name}}
    rm -rf repertoire && cp -r ../repertoire repertoire
    cp starter-c/helper.c starter-c/helper.h {{name}}/
    cp "$(nim dump 2>&1 | grep -m1 '/lib$')/nimbase.h" {{name}}/
    nim c {{name}}/strategy.nim

room-nim:
    rm -rf room-nim && cp -r ../the-choice/nim room-nim
    cp starter-c/helper.c starter-c/helper.h room-nim/
    cp "$(nim dump 2>&1 | grep -m1 '/lib$')/nimbase.h" room-nim/
    nim c room-nim/strategy.nim

ladder-all:
    just nim-bot first-bot
    just nim-bot roles-bot
    just nim-bot tactics-bot
    # Ten rounds play every pair of six bots from both sides, so ten per map
    # meets every pairing on every map.
    just ladder --bots starter-c room-c room-pearls first-bot roles-bot tactics-bot \
        --maps maps/*.map maps-generated/*.map \
        --rounds $((10 * $(ls maps/*.map maps-generated/*.map | wc -l))) \
        --output results/ladder-all

# Compare generated and bundled maps through the same harness.
unseen-maps first="room-c" second="starter-c" count="20" seed="2026":
    #!/usr/bin/env bash
    set -euo pipefail
    mkdir -p results
    directory=$(mktemp -d "$PWD/results/unseen-maps.XXXXXXXX")
    just mapgen --count "$3" --seed "$4" --output "$directory/maps"
    just round-robin --bots "$1" "$2" --maps maps/*.map --sandbox --seeds 2 --output "$directory/bundled"
    just round-robin --bots "$1" "$2" --maps "$directory"/maps/*.map --sandbox --seeds 2 --output "$directory/generated"
    printf 'Comparison results: %s\n' "$directory"
