# Performance article fixtures. Run prepare after building the repository tools.
python := env("LOONG_PYTHON", "python3")
root := env("LOONG_ROOT", justfile_directory() / "../..")
output := root / "build/article-performance"
judge := root / "build/zig-judge/bin/loong-judge"
engine := root / "build/toolkit/unswbc/unswbc_engine.wasm"

prepare:
    #!/usr/bin/env bash
    set -euo pipefail
    root={{quote(root)}}
    output={{quote(output)}}
    mkdir -p "$output"
    mkdir -p "$output/repertoire"
    cp -r ../repertoire/. "$output/repertoire/"
    for name in profiled-bot bench-bot fast-bot machine-bot; do
        rm -rf "$output/$name"
        mkdir -p "$output/$name"
        find "$name" -maxdepth 1 -type f \( -name "*.nim" -o -name "*.c" -o -name "*.h" -o -name "*.cfg" -o -name "*.toml" \) ! -name "helper.c" ! -name "helper.h" ! -name "nimbase.h" ! -name "entry.c" -exec cp {} "$output/$name/" \;
        sed -i 's@../../repertoire@../repertoire@g' "$output/$name/strategy.nim"
        just --justfile "$root/justfile" bot-build "$output/$name" "$output/$name.wasm"
    done
    just --justfile "$root/justfile" bot-build "$root/bots/random" "$output/random.wasm"

# Where the first bot's points go, part by part, over one game.
profile map="arena":
    just _game profiled-bot {{map}} | just _profile-report

# Every room-counting kernel on the same windows, in CPU points.
bench map="arena":
    just _game bench-bot {{map}} | just _profile-report

# The same kernels natively, on windows recorded from real games, under perf.
native kernel="components":
    clang -O2 -march=native -g -fno-omit-frame-pointer -I bench-bot native/bench.c bench-bot/kernels.c -o native/bench
    perf stat -e cycles,instructions,branches,branch-misses native/bench {{kernel}} native/windows.bin

# The first bot, and the same bot with its hot path in C, turn by turn.
fast:
    {{judge}} --engine {{engine}} run --sandbox --no-replay --seed 0x42 {{root}}/tools/evaluation/maps/default.map {{output}}/fast-bot.wasm {{output}}/random.wasm

# Where a kernel spends its cycles, down to the instructions that take more than 2% of them.
native-profile kernel="queue":
    clang -O2 -march=native -g -fno-omit-frame-pointer -I bench-bot native/bench.c bench-bot/kernels.c -o native/bench
    perf record -q -g -o /tmp/loong-perf.data native/bench {{kernel}} native/windows.bin
    perf report -i /tmp/loong-perf.data --stdio --no-children 2>/dev/null | grep -E '^ +[0-9.]+%|--' | head -6
    perf annotate -i /tmp/loong-perf.data --stdio -s RoomsQueue 2>/dev/null | awk '$1 + 0 >= 2.0'

# The benchmark over six maps, logged to bench-six-maps.log for the chart in the performance post.
bench-maps:
    for map in arena default Colosseum trophy big_empty stronghold; do just _game bench-bot $map | grep "LOG bench"; done > bench-six-maps.log
    just _profile-report < bench-six-maps.log
    python3 {{quote(root)}}/../over-yonder.tech/tools/kernel_chart.py bench-six-maps.log {{quote(root)}}/blog/images/room-kernels.svg

# Compile the Rake mask kernel to C for the bench bot. Needs rakec from Rake's wasm-simd128 branch.
# window_bits_polished.h is the same file with one change made by hand, described at its top.
rake:
    rakec --emit-asm --target wasm-simd128 -o bench-bot/window_bits.h rake/window_bits.rk

# The machine bot's loops in the judge, one per turn, then the same loops natively, logged for post 19.
machine:
    just _game machine-bot arena | grep "LOG machine" > machine-judge.log
    clang -O2 -I machine-bot native/machine.c machine-bot/experiments.c -o native/machine
    native/machine > machine-native.log
    cat machine-judge.log machine-native.log

# Profiling output adapter, shared by all point-benchmark recipes.
[private]
_profile-report:
    #!/usr/bin/env -S {{quote(python)}}
    import re
    import statistics
    import sys

    values = {}
    turns = 0
    for line in sys.stdin:
        if "LOG profile" not in line and "LOG bench" not in line:
            continue
        turns += 1
        for name, value in re.findall(r"(\w[\w-]*)=(\d+)", line):
            values.setdefault(name, []).append(int(value))
    width = max(map(len, values), default=0)
    for name, numbers in values.items():
        print(f"{name:<{width}}  {statistics.median(numbers):>12,.0f}")
    print(f"{turns} turns")

# The judge retains bot logs in the replay; expose the article's log lines.
[private]
_game bot map:
    #!/usr/bin/env bash
    set -euo pipefail
    directory={{quote(root)}}/assets/article-performance
    mkdir -p "$directory"
    replay="$directory/{{bot}}-{{map}}.replay"
    {{judge}} --engine {{engine}} run --sandbox --seed 0x42 -o "$replay" {{root}}/tools/evaluation/maps/{{map}}.map {{output}}/{{bot}}.wasm {{output}}/random.wasm >&2
    capnp decode --packed {{root}}/tools/gamedata/replay.capnp Replay < "$replay" | sed -n 's/.*text = "\(profile [^"]*\|bench [^"]*\|machine [^"]*\)".*/LOG \1/p'
