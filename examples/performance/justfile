# Recipes from the profiling and performance posts. Run `just setup` in ../tooling first.
import "../../just/checks.just"
python := env("LOONG_PYTHON", "python3")
tooling := "../tooling"

# Copy the toolkit's helper into a Nim bot here and compile it to C.
nim-bot name:
    cp -f {{tooling}}/starter-c/helper.c {{tooling}}/starter-c/helper.h {{name}}/
    cp -f "$(nim dump 2>&1 | grep -m1 '/lib$')/nimbase.h" {{name}}/
    nim c {{name}}/strategy.nim

# Where the first bot's points go, part by part, over one game.
profile map="arena":
    just nim-bot profiled-bot
    unswbc run --sandbox -v --no-replay --seed 0x42 {{tooling}}/maps/{{map}}.map profiled-bot {{tooling}}/starter-c \
        | just _profile-report

# Every room-counting kernel on the same windows, in CPU points.
bench map="arena":
    just nim-bot bench-bot
    unswbc run --sandbox -v --no-replay --seed 0x42 {{tooling}}/maps/{{map}}.map bench-bot {{tooling}}/starter-c \
        | just _profile-report

# The same kernels natively, on windows recorded from real games, under perf.
native kernel="components":
    clang -O2 -march=native -g -fno-omit-frame-pointer -I bench-bot native/bench.c bench-bot/kernels.c -o native/bench
    perf stat -e cycles,instructions,branches,branch-misses native/bench {{kernel}} native/windows.bin

# The first bot, and the same bot with its hot path in C, turn by turn.
fast:
    just nim-bot fast-bot
    unswbc run --sandbox --no-replay --seed 0x42 {{tooling}}/maps/default.map {{tooling}}/first-bot {{tooling}}/room-c
    unswbc run --sandbox --no-replay --seed 0x42 {{tooling}}/maps/default.map fast-bot {{tooling}}/room-c

# Where a kernel spends its cycles, down to the instructions that take more than 2% of them.
native-profile kernel="queue":
    clang -O2 -march=native -g -fno-omit-frame-pointer -I bench-bot native/bench.c bench-bot/kernels.c -o native/bench
    perf record -q -g -o /tmp/loong-perf.data native/bench {{kernel}} native/windows.bin
    perf report -i /tmp/loong-perf.data --stdio --no-children 2>/dev/null | grep -E '^ +[0-9.]+%|--' | head -6
    perf annotate -i /tmp/loong-perf.data --stdio -s RoomsQueue 2>/dev/null | awk '$1 + 0 >= 2.0'

# The benchmark over six maps, logged to bench-six-maps.log for the chart in the performance post.
bench-maps:
    just nim-bot bench-bot
    for map in arena default Colosseum trophy big_empty stronghold; do unswbc run --sandbox -v --no-replay --seed 0x42 {{tooling}}/maps/$map.map bench-bot {{tooling}}/starter-c | grep "LOG bench"; done > bench-six-maps.log
    just _profile-report < bench-six-maps.log
    python3 ../../tools/kernel_chart.py bench-six-maps.log ../../blog/images/room-kernels.svg

# Compile the Rake mask kernel to C for the bench bot. Needs rakec from Rake's wasm-simd128 branch.
# window_bits_polished.h is the same file with one change made by hand, described at its top.
rake:
    rakec --emit-asm --target wasm-simd128 -o bench-bot/window_bits.h rake/window_bits.rk

# The machine bot's loops in the judge, one per turn, then the same loops natively, logged for post 16.
machine:
    cp -f {{tooling}}/starter-c/helper.c {{tooling}}/starter-c/helper.h machine-bot/
    unswbc run --sandbox -v --no-replay --seed 0x42 {{tooling}}/maps/arena.map machine-bot {{tooling}}/starter-c | grep "LOG machine" > machine-judge.log
    clang -O2 -I machine-bot native/machine.c machine-bot/experiments.c -o native/machine
    native/machine > machine-native.log
    cat machine-judge.log machine-native.log

# Profiling output adapter, shared by all point-benchmark recipes.
[private]
_profile-report:
    #!/usr/bin/env -S {{quote(python)}}
    import re
    import statistics
    import sys

    values = {}
    turns = 0
    for line in sys.stdin:
        if "LOG profile" not in line and "LOG bench" not in line:
            continue
        turns += 1
        for name, value in re.findall(r"(\w[\w-]*)=(\d+)", line):
            values.setdefault(name, []).append(int(value))
    width = max(map(len, values), default=0)
    for name, numbers in values.items():
        print(f"{name:<{width}}  {statistics.median(numbers):>12,.0f}")
    print(f"{turns} turns")
